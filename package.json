{
  "name": "webos-launcher",
  "version": "1.0.3",
  "private": true,
  "description": "Apple TV-style home screen launcher for LG webOS TVs (webOS 4+ / Chromium 53+ compatible)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:appinfo": "node scripts/check-appinfo.mjs",
    "package": "sh scripts/package.sh",
    "tv": "node scripts/tvctl.mjs",
    "install:tv": "sh scripts/install.sh",
    "deploy": "npm run build && npm run package && npm run install:tv",
    "manifest": "node scripts/gen-manifest.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@webos-tools/cli": "^3.2.6",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "license": "MIT"
}
